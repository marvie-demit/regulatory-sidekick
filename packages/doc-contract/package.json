{
  "name": "@notjustany/doc-contract",
  "version": "0.1.0",
  "private": true,
  "description": "The controlled-document skeleton contract: parse, derive and validate a generated HTML fragment against its blank template.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {}
}
